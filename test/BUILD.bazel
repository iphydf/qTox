load("@rules_cc//cc:defs.bzl", "cc_library")
load("@rules_fuzzing//fuzzing:cc_defs.bzl", "cc_fuzz_test")
load("//third_party/qt:build_defs.bzl", "qt_moc", "qt_rcc", "qt_test")

qt_rcc(
    name = "test_data",
    testonly = True,
    srcs = ["resources/test_data.qrc"],
    data = glob(["resources/**/*.png"]),
    tags = ["qt"],
)

COPTS = ["-Iqtox"] + select({
    "//tools/config:freebsd": [],
    "//tools/config:linux": ["-fPIC"],
    "//tools/config:osx": [],
    "//tools/config:windows": [],
})

qt_moc(
    name = "mock_moc",
    testonly = True,
    srcs = ["mock/include/mock/mockcoresettings.h"],
    mocopts = [
        "-Iqtox",
        "-Iqtox/util/include",
    ],
    tags = ["qt"],
    deps = [
        "//qtox/src",
        "//qtox/src:core",
        "//qtox/src:shared",
        "//qtox/util",
    ],
)

cc_library(
    name = "dbutility",
    testonly = True,
    srcs = ["dbutility/src/dbutility.cpp"],
    hdrs = ["dbutility/include/dbutility/dbutility.h"],
    copts = COPTS,
    strip_include_prefix = "dbutility/include",
    tags = ["qt"],
    deps = [
        "//qtox/src",
        "//qtox/src:shared",
        "@qt//:qt_core",
        "@qt//:qt_test",
    ],
)

cc_library(
    name = "mock",
    testonly = True,
    srcs = [
        ":mock_moc",
        ":test_data",
    ] + glob(["mock/src/*.cpp"]),
    hdrs = glob(["mock/include/mock/*.h"]),
    copts = COPTS,
    includes = ["mock/include"],
    tags = ["qt"],
    deps = [
        "//qtox/src",
        "//qtox/src:core",
        "//qtox/src:shared",
        "@qt//:qt_core",
    ],
)

UI_TESTS = ["loginscreen_test"]

TEST_SIZES = {
    "core_test": "large",
}

TEST_DEPS = [
    ":dbutility",
    ":mock",
    "//c-toxcore",
    "//qtox:res_lib",
    "//qtox/src",
    "//qtox/src:core",
    "//qtox/src:shared",
    "//qtox/util",
    "@qt//:qt_core",
    "@qt//:qt_gui",
    "@qt//:qt_network",
    "@qt//:qt_widgets",
]

[qt_test(
    name = src[src.rindex("/") + 1:-4],
    # "medium" for most: they take a second or two alone, but more than the 5 of
    # "small" when every test runs at once.
    size = TEST_SIZES.get(
        src[src.rindex("/") + 1:-4],
        "medium",
    ),
    src = src,
    copts = COPTS,
    mocopts = ["-Iqtox"],
    tags = ["ui"] if src[src.rindex("/") + 1:-4] in UI_TESTS else [],
    deps = TEST_DEPS,
) for src in glob(
    ["**/*_test.cpp"],
    exclude = [
        "audio/voicegate_test.cpp",
        "model/exiftransform_test.cpp",
        "persistence/dbschema_test.cpp",
        "platform/desktopnotifybackend_test.cpp",
        "platform/stacktrace_test.cpp",
        "video/framerotation_test.cpp",
        "video/videoframe_test.cpp",
        "chatlog/text_test.cpp",
        "**/*_fuzz_test.cpp",
        "qml/**",
    ],
)]

cc_library(
    name = "qml_testservice",
    testonly = True,
    hdrs = ["qml/testservice.h"],
    tags = ["qt"],
    deps = ["//qtox/src:qml"],
)

# The QML user interface's. Not the lint's test: it needs qmllint and our plugin.
[qt_test(
    name = name,
    size = size,
    src = "qml/%s.cpp" % name,
    copts = COPTS + [
        "-Iqtox/src/qml",
        "-I$(GENDIR)/qtox/src/qml",
        # Qt's repc writes "using namespace" into the headers it generates.
        "-Wno-header-hygiene",
    ],
    mocopts = ["-Iqtox"],
    qml = True,
    deps = [
        ":mock",
        ":qml_testservice",
        "//c-toxcore",
        "//qtox:res_lib",
        "//qtox/src:core",
        "//qtox/src:qml",
        "//qtox/src:shared",
        "//qtox/util",
        "@qt//:qt_core",
        "@qt//:qt_gui",
        "@qt//:qt_network",
        "@qt//:qt_qml",
        "@qt//:qt_quick",
        "@qt//:qt_quickcontrols2",
        "@qt//:qt_remoteobjects",
    ],
) for name, size in {
    # 14 seconds alone, over the 30 of "medium" when every test runs at once.
    "pages_test": "large",
    # About 2 minutes: it logs in several times and waits for real Tox friends.
    "toxservice_test": "enormous",
}.items()]

